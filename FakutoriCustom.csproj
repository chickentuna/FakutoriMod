<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>FakutoriCustom</AssemblyName>
    <Product>FakutoriCustomBlocks</Product>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>FakutoriCustom</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>E:\SteamLibrary\steamapps\common\Fakutori Demo\BepInEx\plugins\$(AssemblyName)</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.13" />
  </ItemGroup>

   <ItemGroup>
      <Reference Include="Assembly-CSharp">
          <HintPath>lib/Assembly-CSharp.dll</HintPath>
      </Reference>
      <Reference Include="Unity.InputSystem">
          <HintPath>lib/Unity.InputSystem.dll</HintPath>
      </Reference>
      <Reference Include="Unity.TextMeshPro">
          <HintPath>lib/Unity.TextMeshPro.dll</HintPath>
      </Reference>
      <Reference Include="Sirenix.Serialization">
          <HintPath>lib/Sirenix.Serialization.dll</HintPath>
      </Reference>
      <Reference Include="UnityEngine.UI">
          <HintPath>lib/UnityEngine.UI.dll</HintPath>
      </Reference>
    </ItemGroup>
  
  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
